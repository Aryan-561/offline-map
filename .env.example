# Copy to .env for local development. Never commit .env.

# Base URL of the routing-data service served by tools/routing-data/server.mjs.
# Use your computer's LAN IP so a physical device can reach it.
EXPO_PUBLIC_ROUTING_DATA_BASE_URL=http://192.168.0.198:8787

# Must match the Valhalla version used by the native engine and tile builder.
EXPO_PUBLIC_VALHALLA_ENGINE_VERSION=3.9.1

# Extra coverage around the map region. Keep 0 to download routing data for
# exactly the same area as the map.
EXPO_PUBLIC_ROUTING_BUFFER_KM=0

# The reference backend serves per-file directory packages.
EXPO_PUBLIC_ROUTING_PACKAGE_FORMAT=directory

# Base URL of the BRouter data release. It must contain brouter-manifest.json,
# the mirrored .rd5 segment tiles and the places-*.sqlite indexes.
EXPO_PUBLIC_BROUTER_DATA_BASE_URL=

# BRouter build bundled in modules/brouter-engine.
EXPO_PUBLIC_BROUTER_ENGINE_VERSION=1.7.10

# Optional online Valhalla endpoint for the non-offline navigation flow.
EXPO_PUBLIC_VALHALLA_URL=

# Place-name search. Photon is the default (public instance, no API key).
# Set the provider to "nominatim" if the URL points at a Nominatim server.
EXPO_PUBLIC_PLACE_SEARCH_PROVIDER=photon
EXPO_PUBLIC_PLACE_SEARCH_URL=https://photon.komoot.io/api

# Only used by Nominatim, where the usage policy asks that requests identify
# the application.
EXPO_PUBLIC_PLACE_SEARCH_EMAIL=
